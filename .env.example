# Copy to .env and fill in. Used by docker-compose.yml (and by the backend when run locally).

# Public URL people use to reach AlloGator (through oauth2-proxy).
ALLOGATOR_BASE_URL=http://localhost:4180
# Comma-separated emails that are always admins.
ALLOGATOR_ADMIN_EMAILS=you@example.com
POSTGRES_PASSWORD=change-me

# --- Sign-in via oauth2-proxy (any OIDC provider: Google, Okta, Entra ID, Keycloak, ...) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://accounts.google.com
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Generate with: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_COOKIE_SECURE=false

# --- Email (optional; without it emails are logged instead of sent) ---
ALLOGATOR_SMTP_HOST=
ALLOGATOR_SMTP_PORT=587
ALLOGATOR_SMTP_USERNAME=
ALLOGATOR_SMTP_PASSWORD=
ALLOGATOR_SMTP_FROM=AlloGator <oncall@example.com>
